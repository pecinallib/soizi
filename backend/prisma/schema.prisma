generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  password     String
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  remittances  Remittance[]

  @@map("users")
}

model Remittance {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  originCurrency  String           @map("origin_currency")
  targetCurrency  String           @map("target_currency")
  originAmount    Decimal          @map("origin_amount") @db.Decimal(15, 2)
  targetAmount    Decimal          @map("target_amount") @db.Decimal(15, 2)
  exchangeRate    Decimal          @map("exchange_rate") @db.Decimal(15, 6)
  fee             Decimal          @db.Decimal(15, 2)
  spread          Decimal          @db.Decimal(5, 4)
  totalCost       Decimal          @map("total_cost") @db.Decimal(15, 2)
  status          RemittanceStatus @default(PENDING)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("remittances")
}

model Explanation {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  description String
  example     String?
  category    String
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("explanations")
}

enum RemittanceStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}